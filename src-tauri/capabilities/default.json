{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the main window and the tray's menu",
  "windows": ["main", "tray-menu"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
